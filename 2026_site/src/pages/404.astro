---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Band from '@/components/hud/Band.astro';
import DiagnosticTrigger from '@/components/hud/DiagnosticTrigger.astro';
import { withBase } from '@/lib/utils';
---

<BaseLayout title="Signal lost">
  <Band tone="about" labelledby="nf-title" class="grid min-h-[70dvh] content-center py-20">
    <p class="hud-label text-accent"><span aria-hidden="true">// </span>Error 404 · Page not found</p>
    <h1 id="nf-title" class="mt-4 display-wide text-[clamp(4rem,20vw,14rem)]">Signal<br /><span class="text-accent">Lost</span></h1>
    <div aria-hidden="true" class="my-8 h-4 max-w-md hazard-stripes"></div>
    <p class="max-w-prose text-muted">The coordinates you requested don't resolve to any known sector.</p>
    <div class="mt-8"><DiagnosticTrigger href={withBase('/')} code="RST-00" label="Return to base" /></div>
  </Band>
</BaseLayout>
