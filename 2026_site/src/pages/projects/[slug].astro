---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HudFrame from '@/components/hud/HudFrame.astro';
import Band from '@/components/hud/Band.astro';
import { projects, type Project } from '@/data/projects';
import { pad, withBase } from '@/lib/utils';

export const getStaticPaths = (() =>
  projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props { project: Project }
const { project } = Astro.props;

const i = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(i + 1) % projects.length]!;
const frameLabel = project.image.frame === 'telemetry' ? 'Intercepted Telemetry Capture' : 'System Schematic';
---

<BaseLayout title={project.title} description={project.summary}>
  <!-- Case studies inherit the Projects band tone (deep navy). -->
  <Band tone="projects" labelledby="project-title">
  <article class="py-10 sm:py-16">
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex flex-wrap items-center gap-2 hud-label text-muted">
        <li><a href={withBase('/')} class="hover:text-accent">Root</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={withBase('/#projects')} class="hover:text-accent">Projects</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-fg">{project.code}</li>
      </ol>
    </nav>

    <header class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="hud-label text-accent">// {[project.code, project.era, project.status].filter(Boolean).join(' · ')}</p>
        <!-- Same view-transition name as the card title → the title morphs between pages. -->
        <h1
          id="project-title"
          class="mt-4 display-wide text-[clamp(2.5rem,9vw,6.5rem)]"
          transition:name={`project-${project.slug}`}
        >
          {project.title}
        </h1>
      </div>
      <p class="text-muted lg:col-span-4">{project.summary}</p>
    </header>

    <HudFrame label="CAPTURE" meta={frameLabel.toUpperCase()} class="mt-14 bg-bg p-2 sm:p-3">
      <figure>
        <img
          src={withBase(project.image.src)}
          alt={project.image.alt}
          width={project.image.width}
          height={project.image.height}
          class="h-auto w-full"
          fetchpriority="high"
        />
        <figcaption class="sr-only">{project.image.alt}</figcaption>
      </figure>
    </HudFrame>

    <div class="mt-14 grid gap-10 lg:grid-cols-12">
      <section class="lg:col-span-7" aria-labelledby="brief">
        <h2 id="brief" class="hud-label text-accent">// MISSION BRIEF</h2>
        <p class="mt-4 text-lg leading-relaxed">{project.description}</p>

        <h2 class="mt-10 hud-label text-accent">// SCOPE</h2>
        <ol class="mt-4 border border-line-strong">
          {project.scope.map((line, n) => (
            <li class="grid grid-cols-[4ch_1fr] gap-3 border-b border-line p-3 last:border-b-0">
              <span class="text-accent">{pad(n + 1)}</span><span>{line}</span>
            </li>
          ))}
        </ol>

      </section>

      <aside class="space-y-6 lg:col-span-5" aria-label="Project metadata">
        <dl class="grid grid-cols-2 border border-line-strong">
          {project.telemetry.map((t) => (
            <div class="border-b border-r border-line p-3 even:border-r-0">
              <dt class="hud-label text-muted">{t.k}</dt>
              <dd class="mt-1 text-lg font-bold tabular-nums">{t.v}</dd>
            </div>
          ))}
        </dl>

        <div>
          <h2 class="hud-label text-accent">// STACK</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {project.stack.map((s) => (
              <li class="border border-line-strong px-2 py-1 hud-label">{s}</li>
            ))}
          </ul>
        </div>

        <p class="flex items-center gap-2 hud-label text-muted">
          <span aria-hidden="true" class="size-2 bg-line-strong"></span> Source and production links not public
        </p>
      </aside>
    </div>

    <nav aria-label="Next project" class="mt-20 border-t border-line-strong pt-6">
      <a href={withBase(`/projects/${next.slug}`)} class="group flex flex-wrap items-baseline justify-between gap-4">
        <span class="hud-label text-muted">NEXT // {next.code}</span>
        <span class="display-wide text-3xl group-hover:text-accent sm:text-5xl">{next.title} →</span>
      </a>
    </nav>
  </article>
  </Band>
</BaseLayout>
