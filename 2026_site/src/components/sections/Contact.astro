---
import Band from '@/components/hud/Band.astro';
import SectionHeader from '@/components/hud/SectionHeader.astro';
import HudFrame from '@/components/hud/HudFrame.astro';
import { site, socials } from '@/data/site';
import { withBase } from '@/lib/utils';

const [emailUser, emailDomain] = site.email.split('@');
---

<Band tone="contact" id="contact" labelledby="contact-title" class="pt-12 pb-8 sm:pt-16">
  <SectionHeader index="04" code="UPLINK.OPEN" title="Contact" id="contact-title" />

  <div class="grid gap-10 lg:grid-cols-12">
    <HudFrame label="TX" meta="PRIMARY CHANNEL" class="@container bg-surface/60 p-6 pt-10 sm:p-10 lg:col-span-7">
      <p class="hud-label text-muted">EMAIL COORDINATES</p>
      <a
        href={`mailto:${site.email}`}
        data-track="contact_email"
        class="wipe mt-4 -mx-2 inline-block px-2 py-1 display-wide text-[clamp(1rem,6.6cqi,3.75rem)]"
      >
        <!-- Only allow a break before the "@" so the domain + TLD always stay on one line. -->
        <span class="whitespace-nowrap">{emailUser}</span><wbr /><span class="whitespace-nowrap">@{emailDomain}</span>
      </a>
      <p class="mt-6 max-w-prose text-muted">
        Hiring, collaborating, or just want to compare notes on interface design? Transmissions are read within
        48 hours, {site.timezone.split('/')[1]?.replace('_', ' ')} time.
      </p>
    </HudFrame>

    <nav aria-label="Social channels" class="lg:col-span-5">
      <p aria-hidden="true" class="mb-3 hud-label text-accent">// SECURE CHANNELS</p>
      <ul class="border border-line-strong">
        {socials.map((s) => {
          const external = s.href.startsWith('http');
          return (
            <li class="border-b border-line last:border-b-0">
              <a
                href={external ? s.href : withBase(s.href)}
                data-track={`contact_${s.track}`}
                {...(external ? { target: '_blank', rel: 'me noopener noreferrer' } : {})}
                class="wipe group grid min-h-14 grid-cols-[7ch_1fr_auto] items-center gap-3 px-4 py-3"
              >
                <span aria-hidden="true" class="hud-label text-muted">{s.channel}</span>
                <span class="font-semibold uppercase tracking-wider">{s.label}</span>
                <span aria-hidden="true" class="hud-label">{external ? '↗' : '↓'}</span>
                {external && <span class="sr-only">(opens in new tab)</span>}
              </a>
            </li>
          );
        })}
      </ul>
      <p aria-hidden="true" class="mt-4 flex items-center gap-2 hud-label text-muted">
        <span class="size-2 bg-signal"></span> ENCRYPTION: TLS 1.3 / HSTS
      </p>
    </nav>
  </div>
</Band>
