---
import Band from '@/components/hud/Band.astro';
import SectionHeader from '@/components/hud/SectionHeader.astro';
import ProfileSlot from '@/components/hud/ProfileSlot.astro';
import { site } from '@/data/site';
import { skillMatrix } from '@/data/skills';

const dossier = [
  ['SUBJECT', site.name],
  ['CALLSIGN', site.callsign],
  ['ROLE', site.title],
  ['SPECIALTY', site.subtitle],
  ['BASE', site.location],
  ['CLEARANCE', 'PUBLIC'],
] as const;
---

<Band tone="about" id="about" labelledby="about-title" class="pt-12 pb-8 sm:pt-16">
  <SectionHeader index="01" code="SYSTEM.PROFILE" title="About" id="about-title" />

  <div class="grid gap-10 lg:grid-cols-12">
    <!-- Dossier -->
    <article class="lg:col-span-5" aria-label="System profile">
      <ProfileSlot />
      <dl class="border border-line-strong">
        {dossier.map(([k, v]) => (
          <div class="grid grid-cols-[11ch_1fr] border-b border-line last:border-b-0">
            <dt class="border-r border-line bg-surface-2 px-3 py-2.5 hud-label text-muted">{k}</dt>
            <dd class="px-3 py-2.5 text-sm font-semibold">{v}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-6 space-y-4 border-l-2 border-accent pl-5 text-[0.95rem] leading-relaxed">
        <p>
          I'm a frontend-leaning engineer who treats the interface as a system: tokens, primitives, data flow and
          build tooling designed together so the product stays fast and consistent as it grows.
        </p>
        <p class="text-muted">
          Lately: design systems, performance budgets, and shipping more HTML with less JavaScript.
          <!-- TODO: add a line about life outside work. -->
        </p>
      </div>
    </article>

    <!-- Skills matrix -->
    <div class="lg:col-span-7">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="hud-label text-accent">// CAPABILITY MATRIX</h3>
        <p class="hud-label text-muted" id="skill-legend">SIGNAL ▮ = PROFICIENCY 1–5</p>
      </div>
      <div class="grid gap-px border border-line-strong bg-line-strong sm:grid-cols-2">
        {skillMatrix.map((group) => (
          <section class="bg-bg" aria-labelledby={`skills-${group.id}`}>
            <h4 id={`skills-${group.id}`} class="flex items-center justify-between border-b border-line bg-surface px-3 py-2">
              <span class="hud-label">{group.label}</span>
              <span class="hud-label text-muted">{group.id}</span>
            </h4>
            <table class="w-full text-sm" aria-describedby="skill-legend">
              <caption class="sr-only">{group.label} skills with proficiency and years</caption>
              <thead class="sr-only">
                <tr><th scope="col">Skill</th><th scope="col">Proficiency</th><th scope="col">Years</th></tr>
              </thead>
              <tbody>
                {group.skills.map((s) => (
                  <tr class="border-b border-line last:border-b-0">
                    <th scope="row" class="px-3 py-2 text-left font-normal">{s.name}</th>
                    <td class="px-2 py-2">
                      <span class="sr-only">{s.level} of 5</span>
                      <span aria-hidden="true" class="flex gap-0.5">
                        {[1, 2, 3, 4, 5].map((n) => (
                          <span class:list={['h-3 w-2', n <= s.level ? 'bg-accent' : 'bg-surface-2']} />
                        ))}
                      </span>
                    </td>
                    <td class="w-12 px-3 py-2 text-right tabular-nums text-muted">
                      {s.years ? `${s.years}y` : '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        ))}
      </div>
    </div>
  </div>
</Band>
