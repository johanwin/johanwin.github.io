---
import { withBase } from '@/lib/utils';
/**
 * "Get to Know John" video: a thumbnail card in the About dossier that opens a
 * native <dialog> with the YouTube player.
 *
 * Lazy by design: nothing from YouTube loads until the visitor clicks play —
 * the poster is a self-hosted lazy <img> (public/images/profile/video-poster.webp,
 * Muybridge's "The Horse in Motion" (1878, public domain) as film strips in the
 * About palette — face-free since the portrait is already in this section, with
 * its centre left clear for the play button), and the iframe (youtube-nocookie) is injected
 * on open and removed on close, which also stops playback.
 * Crawl-friendly: a plain "Watch on YouTube" link is always in the HTML.
 */
interface Props {
  id?: string;
  title?: string;
  blurb?: string;
  /** Backstory shown under the player in the dialog (and read as its description). */
  context?: string;
  class?: string;
}
const {
  id = 'klY4DYcGslI',
  title = 'Get to Know John',
  class: className,
  blurb = 'A quick intro in my own words: who I am, how I work, and what I care about building.',
  context = 'Made in early 2022, before ChatGPT was released to the public, for my employer\'s “Getting to Know You” series, where colleagues gave a short presentation about themselves. I leaned into the series name by theming the video on the film adaptation of',
} = Astro.props;

const watchUrl = `https://youtu.be/${id}`;
const poster = withBase('/images/profile/video-poster.webp');
// 10-frame sprite cut from the same artwork (built by design/video-sprite.mjs).
const gallop = withBase('/images/profile/video-gallop.webp');
---

<div class:list={['border border-line-strong bg-bg/40', className]} data-video data-video-id={id} data-video-title={title}>
  <div aria-hidden="true" class="flex items-center justify-between border-b border-line-strong px-3 py-2">
    <p class="hud-label text-accent">// TRANSMISSION.VID-01</p>
    <p class="hud-label text-[0.6rem] text-muted">UNLISTED FEED</p>
  </div>

  <button
    type="button"
    data-video-open
    data-track="video_play"
    aria-haspopup="dialog"
    class="group/wipe block w-full cursor-pointer text-left"
  >
    <span class="crt block aspect-video border-b border-line-strong">
      <span class="lazy-media absolute! inset-0">
        <img
          src={poster}
          alt=""
          width="960"
          height="540"
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      </span>
      <!-- Projector: the poster's 10 frames play back in its empty centre band at
           a choppy ~8 fps, while a playhead jumps to the matching cell on the strip.
           Motion off → frame 01 with the playhead parked on cell 01. -->
      <span aria-hidden="true" class="vb-gallop">
        <img src={gallop} alt="" width="1820" height="114" loading="lazy" decoding="async" />
      </span>
      <span aria-hidden="true" class="vb-playhead"></span>
      <span aria-hidden="true" class="vb-play absolute z-[4] grid place-items-center">
        <span class="wipe grid size-full place-items-center border-2 border-accent bg-bg/70 text-accent sm:text-lg">▶</span>
      </span>
      <span aria-hidden="true" class="crt-roll crt-hover"></span>
    </span>
    <span class="flex items-center gap-3 px-3 py-3">
      <span class="font-semibold uppercase tracking-wider">{title}</span>
      <span class="ml-auto hud-label text-accent"><span aria-hidden="true">▶ </span>Play video</span>
    </span>
  </button>

  <p class="border-t border-line px-3 py-3 text-sm leading-relaxed text-muted">
    {blurb}
    <a href={watchUrl} data-track="video_youtube" target="_blank" rel="noopener noreferrer" class="whitespace-nowrap text-fg underline decoration-accent underline-offset-4 hover:text-accent">
      Watch on YouTube ↗<span class="sr-only"> (opens in new tab)</span>
    </a>
  </p>

  <dialog
    data-video-dialog
    aria-labelledby="video-dialog-title"
    aria-describedby="video-dialog-context"
    class="video-dialog m-auto max-h-[calc(100dvh-2rem)] w-[min(64rem,calc(100vw-2rem))] max-w-none overflow-y-auto border-2 border-accent bg-bg p-0 text-fg"
  >
    <div class="flex items-stretch border-b border-line-strong">
      <span aria-hidden="true" class="flex items-center bg-accent px-3 hud-label text-accent-fg">PLAYBACK</span>
      <h2 id="video-dialog-title" class="flex min-w-0 items-center truncate px-3 hud-label">{title}</h2>
      <button type="button" data-video-close data-track="video_close" class="wipe ml-auto flex min-h-11 items-center gap-2 border-l border-line-strong px-4 hud-label">
        Close <span aria-hidden="true">✕</span>
      </button>
    </div>
    <div data-video-slot class="aspect-video bg-black"></div>
    <!-- Backstory: what the video was made for (also the dialog's description). -->
    <div class="flex flex-col gap-1.5 border-t border-line-strong px-4 py-3 sm:flex-row sm:gap-3 sm:px-5 sm:py-4">
      <span aria-hidden="true" class="hud-label shrink-0 text-accent sm:pt-1">// NOTE</span>
      <p id="video-dialog-context" class="max-w-prose text-sm leading-relaxed text-muted">
        {context} <cite class="not-italic text-fg"><i>The King and I</i></cite>, which features a song of the same name.
      </p>
    </div>
  </dialog>
</div>

<style>
  .video-dialog::backdrop {
    background: rgb(0 0 0 / 0.8);
    backdrop-filter: blur(4px);
  }
  .video-dialog[open] { animation: hud-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  :global(html:has(.video-dialog[open])) { overflow: hidden; }

  /* All boxes are % of the 16:9 poster (1280×720): centre band y 236–484,
     film cells 244×152 at x = 10 + 254·i on rows y = 62 and 506. */
  .vb-gallop {
    position: absolute;
    z-index: 1;
    left: 36.5%;
    top: 35%;
    width: 27%;
    aspect-ratio: 182 / 114;
    overflow: hidden;
    filter: drop-shadow(0 0 10px color-mix(in oklab, var(--accent) 35%, transparent));
  }
  .vb-gallop img {
    display: block;
    width: 1000%;
    max-width: none;
    height: 100%;
    animation: vb-gallop 1.2s steps(10, end) infinite;
  }
  @keyframes vb-gallop { to { translate: -100% 0; } }

  .vb-playhead {
    position: absolute;
    z-index: 1;
    left: 0.78%;
    top: 8.61%;
    width: 19.06%;
    height: 21.11%;
    border: 2px solid var(--accent);
    box-shadow: 0 0 12px color-mix(in oklab, var(--accent) 45%, transparent);
    pointer-events: none;
    animation: vb-playhead 1.2s steps(1, end) infinite;
  }
  @keyframes vb-playhead {
    0%   { left: 0.78%;  top: 8.61%; }
    10%  { left: 20.63%; top: 8.61%; }
    20%  { left: 40.47%; top: 8.61%; }
    30%  { left: 60.31%; top: 8.61%; }
    40%  { left: 80.16%; top: 8.61%; }
    50%  { left: 0.78%;  top: 70.28%; }
    60%  { left: 20.63%; top: 70.28%; }
    70%  { left: 40.47%; top: 70.28%; }
    80%  { left: 60.31%; top: 70.28%; }
    90%, 100% { left: 80.16%; top: 70.28%; }
  }

  /* Play button moves to the right of the centre band so the horse owns the middle. */
  .vb-play {
    right: 4%;
    top: 50%;
    width: 11%;
    aspect-ratio: 1;
    translate: 0 -50%;
  }
</style>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('[data-video]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';

      const dialog = root.querySelector<HTMLDialogElement>('[data-video-dialog]')!;
      const slot = root.querySelector<HTMLElement>('[data-video-slot]')!;
      const opener = root.querySelector<HTMLButtonElement>('[data-video-open]')!;
      const { videoId, videoTitle } = root.dataset;

      opener.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&playsinline=1`;
        iframe.title = videoTitle ?? 'Video';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.allowFullscreen = true;
        iframe.className = 'size-full';
        slot.replaceChildren(iframe);
        dialog.showModal();
        (window as { gtag?: (...a: unknown[]) => void }).gtag?.('event', 'video_open', { video_id: videoId, video_title: videoTitle });
      });

      root.querySelector('[data-video-close]')!.addEventListener('click', () => dialog.close());
      // Click on the backdrop (the dialog box itself, outside its content) closes it.
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
      // Tear down the player so audio stops and nothing keeps running.
      dialog.addEventListener('close', () => { slot.replaceChildren(); opener.focus(); });
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
