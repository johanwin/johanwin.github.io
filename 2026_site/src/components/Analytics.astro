---
/**
 * Google Analytics 4 (gtag.js).
 *
 * - Only rendered in production builds so local dev doesn't pollute reports.
 * - The site uses Astro's ClientRouter, so page views are sent manually on
 *   every `astro:page-load` (initial load + each client-side navigation)
 *   instead of relying on gtag's automatic page_view.
 * - One delegated listener reports clicks on links, buttons and any element
 *   marked with `data-track="name"` as a `ui_click` event.
 * - gtag.js itself is deferred: it's injected only after the page's `load`
 *   event, when the browser is idle (4s cap), so it never competes with first
 *   render or hydration. Everything tracked before then (the first page_view,
 *   early clicks) waits in window.dataLayer and is sent once the script runs —
 *   the standard gtag queue, so nothing is lost.
 */
const GA_ID = 'G-4H2DVN8V8K';
const enabled = import.meta.env.PROD;
---

{
  enabled && (
    <>
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };

        if (!window.__gaInit) {
          window.__gaInit = true;
          gtag('js', new Date());
          gtag('config', GA_ID, { send_page_view: false });

          // Deferred loader: after load + idle (or 4s at most).
          const loadGtag = () => {
            const s = document.createElement('script');
            s.async = true;
            s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
            document.head.appendChild(s);
          };
          const whenIdle = () =>
            'requestIdleCallback' in window ? requestIdleCallback(loadGtag, { timeout: 4000 }) : setTimeout(loadGtag, 1500);
          if (document.readyState === 'complete') whenIdle();
          else addEventListener('load', whenIdle, { once: true });

          document.addEventListener('astro:page-load', () => {
            gtag('event', 'page_view', {
              page_title: document.title,
              page_location: location.href,
              page_path: location.pathname + location.hash,
            });
          });

          const clean = (s) => (s || '').replace(/\s+/g, ' ').trim().slice(0, 100);

          document.addEventListener(
            'click',
            (e) => {
              const el = e.target instanceof Element
                ? e.target.closest('[data-track], a[href], button, [role="button"]')
                : null;
              if (!el) return;

              const href = el.getAttribute('href') || undefined;
              let linkType = 'button';
              if (href) {
                if (href.startsWith('mailto:')) linkType = 'email';
                else if (href.startsWith('tel:')) linkType = 'phone';
                else if (href.startsWith('#')) linkType = 'anchor';
                else {
                  try {
                    linkType = new URL(href, location.href).origin === location.origin ? 'internal' : 'outbound';
                  } catch { linkType = 'link'; }
                }
              }

              gtag('event', 'ui_click', {
                click_name: el.getAttribute('data-track') || undefined,
                click_text: clean(el.getAttribute('aria-label') || el.textContent),
                click_url: href,
                link_type: linkType,
                section: el.closest('section[id]')?.id || (el.closest('header') ? 'header' : el.closest('footer') ? 'footer' : undefined),
                page_path: location.pathname,
              });
            },
            { capture: true },
          );
        }
      </script>
    </>
  )
}
