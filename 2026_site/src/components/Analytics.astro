---
/**
 * Google Analytics 4 (gtag.js).
 *
 * - Only rendered in production builds so local dev doesn't pollute reports.
 * - The site uses Astro's ClientRouter, so page views are sent manually on
 *   every `astro:page-load` (initial load + each client-side navigation)
 *   instead of relying on gtag's automatic page_view.
 * - One delegated listener reports clicks on links, buttons and any element
 *   marked with `data-track="name"` as a `ui_click` event:
 *     click_name  stable id from data-track (e.g. slideshow_next, contact_resume)
 *     click_text  what a screen reader announces (decorative aria-hidden glyphs
 *                 like ▶ ◀ ❚❚ dropped, sr-only expansions kept)
 *     project     slug from the nearest [data-track-project]
 *     section     nearest [data-track-section] / section[id] / header / footer
 * - Slideshows (<channel-show>, events bubble up):
 *     slideshow_navigate   user pressed CH−/CH+ or swiped (project, slide_index,
 *                          slide_label, input: button|swipe)
 *     slideshow_pause/play user pressed the pause toggle
 *     project_preview      first hover-preview switch on a project card per page
 * - gtag.js itself is deferred: it's injected only after the page's `load`
 *   event, when the browser is idle (4s cap), so it never competes with first
 *   render or hydration. Everything tracked before then (the first page_view,
 *   early clicks) waits in window.dataLayer and is sent once the script runs —
 *   the standard gtag queue, so nothing is lost.
 */
const GA_ID = 'G-4H2DVN8V8K';
const enabled = import.meta.env.PROD;
---

{
  enabled && (
    <>
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };

        if (!window.__gaInit) {
          window.__gaInit = true;
          gtag('js', new Date());
          gtag('config', GA_ID, { send_page_view: false });

          // Deferred loader: after load + idle (or 4s at most).
          const loadGtag = () => {
            const s = document.createElement('script');
            s.async = true;
            s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
            document.head.appendChild(s);
          };
          const whenIdle = () =>
            'requestIdleCallback' in window ? requestIdleCallback(loadGtag, { timeout: 4000 }) : setTimeout(loadGtag, 1500);
          if (document.readyState === 'complete') whenIdle();
          else addEventListener('load', whenIdle, { once: true });

          document.addEventListener('astro:page-load', () => {
            gtag('event', 'page_view', {
              page_title: document.title,
              page_location: location.href,
              page_path: location.pathname + location.hash,
            });
          });

          const clean = (s) => (s || '').replace(/\s+/g, ' ').trim().slice(0, 100);
          // Accessible text: drop aria-hidden decoration, keep sr-only text.
          const label = (el) => {
            if (el.getAttribute('aria-label')) return clean(el.getAttribute('aria-label'));
            const copy = el.cloneNode(true);
            copy.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove());
            return clean(copy.textContent);
          };
          const project = (el) => el.closest('[data-track-project]')?.getAttribute('data-track-project') || undefined;
          const section = (el) =>
            el.closest('[data-track-section]')?.getAttribute('data-track-section') ||
            el.closest('section[id]')?.id ||
            (el.closest('header') ? 'header' : el.closest('footer') ? 'footer' : undefined);

          // Slideshow events (bubble from <channel-show>).
          const previewed = new Set();
          document.addEventListener('channelchange', (e) => {
            const d = e.detail || {};
            const proj = project(e.target);
            if (d.announce) {
              gtag('event', 'slideshow_navigate', {
                project: proj, slide_index: d.index + 1, slide_total: d.total, slide_label: clean(d.alt), input: d.via, page_path: location.pathname,
              });
            } else if (d.mode === 'hover' && proj && !previewed.has(proj)) {
              previewed.add(proj);
              gtag('event', 'project_preview', { project: proj, page_path: location.pathname });
            }
          });
          document.addEventListener('channelpause', (e) => {
            if (!e.detail?.user) return;
            gtag('event', e.detail.paused ? 'slideshow_pause' : 'slideshow_play', { project: project(e.target), page_path: location.pathname });
          });
          // New page via the client router → previews count again.
          document.addEventListener('astro:page-load', () => previewed.clear());

          document.addEventListener(
            'click',
            (e) => {
              const el = e.target instanceof Element
                ? e.target.closest('[data-track], a[href], button, [role="button"]')
                : null;
              if (!el) return;

              const href = el.getAttribute('href') || undefined;
              let linkType = 'button';
              if (href) {
                if (href.startsWith('mailto:')) linkType = 'email';
                else if (href.startsWith('tel:')) linkType = 'phone';
                else if (href.startsWith('#')) linkType = 'anchor';
                else {
                  try {
                    linkType = new URL(href, location.href).origin === location.origin ? 'internal' : 'outbound';
                  } catch { linkType = 'link'; }
                }
              }

              gtag('event', 'ui_click', {
                click_name: el.getAttribute('data-track') || undefined,
                click_text: label(el),
                click_url: href,
                link_type: linkType,
                project: project(el),
                section: section(el),
                page_path: location.pathname,
              });
            },
            { capture: true },
          );
        }
      </script>
    </>
  )
}
